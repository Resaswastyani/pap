# Salin ke .env.local lalu isi nilainya
# Host MySQL Hostinger: hPanel > Databases > Remote MySQL (mis. srvXXXX.hstgr.io)
DB_HOST=
DB_PORT=3306
DB_NAME=u982265876_pap
DB_USER=u982265876_simpap
DB_PASSWORD=
# String acak panjang untuk menandatangani cookie sesi
AUTH_SECRET=

# Zona waktu sesi MySQL (default WIB)
DB_TIMEZONE=+07:00

# Google reCAPTCHA (https://www.google.com/recaptcha/admin)
# v3: verifikasi tak terlihat berbasis skor (dipakai bila key v2 kosong)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# v2 Checkbox: kotak "I'm not a robot" (bisa berisi puzzle) yang wajib dicentang di setiap login.
# Bila diisi, v2 dipakai menggantikan v3. Kosongkan semua untuk menonaktifkan captcha.
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
# Skor minimal v3 (0.0 - 1.0)
RECAPTCHA_MIN_SCORE=0.5

# Web Push: notifikasi muncul di HP/desktop walau aplikasi ditutup.
# Buat sekali (jangan diganti-ganti, perangkat yang sudah berlangganan akan berhenti menerima):
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'}).privateKey.export({format:'jwk'});console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),Buffer.from(k.x,'base64url'),Buffer.from(k.y,'base64url')]).toString('base64url')+'\nVAPID_PRIVATE_KEY='+k.d)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pandawaamerta.co.id
# Rahasia untuk /api/cron/reminders (dipanggil cron-job.org setiap menit)
CRON_SECRET=
# Google Drive (Master Data > Logo & Desain), pilih salah satu:
# a) Akun Google (disarankan): OAuth client "Web application" dengan redirect URI
#    https://<domain>/api/master/drive/oauth/callback, lalu admin klik "Hubungkan akun Google".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# b) Service account: isi file kunci JSON service account (satu baris, atau base64).
# Bagikan folder desain ke client_email service account sebagai Viewer. Cron: /api/cron/drive-sync tiap 30 menit.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alamat publik aplikasi (wajib di VPS di belakang Nginx), mis. https://sistem-management-pap.pandawaamerta.co.id
APP_URL=
