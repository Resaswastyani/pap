# Salin ke .env.local lalu isi nilainya
# Host MySQL Hostinger: hPanel > Databases > Remote MySQL (mis. srvXXXX.hstgr.io)
DB_HOST=
DB_PORT=3306
DB_NAME=u982265876_pap
DB_USER=u982265876_simpap
DB_PASSWORD=
# String acak panjang untuk menandatangani cookie sesi
AUTH_SECRET=

# Zona waktu sesi MySQL (default WIB)
DB_TIMEZONE=+07:00

# Google reCAPTCHA (https://www.google.com/recaptcha/admin)
# v3: verifikasi tak terlihat di setiap login. Kosongkan untuk menonaktifkan captcha.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# v2 Checkbox (opsional): puzzle yang muncul bila skor v3 di bawah RECAPTCHA_MIN_SCORE
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
